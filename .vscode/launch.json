  "version": "0.2.0",
  "configurations": [






    {
      "name": "Python: intrinsics_calibration",
      "type": "python",
      "request": "launch",
      "program": "/workspace/programming/robotics/calibration/intrinsics_calibration.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["/workspace/programming/robotics/calibration/chessboard"],
      "purpose": ["debug-in-terminal"]
    },

    {
      "name": "Python: extrinsic_calibration.py",
      "type": "python",
      "request": "launch",
      "program": "/workspace/programming/robotics/calibration/extrinsic_calibration.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["/workspace/programming/robotics/calibration/chessboard/intrinsics.json", "/workspace/programming/robotics/calibration/chessboard/left01.jpg", "--undistord"],
      "purpose": ["debug-in-terminal"]
    },

    {
      "name": "(gdb) Launch kitti_vo_testbench",
      "type": "cppdbg",
      "request": "launch",
      "program": "/atom/programming/robotics/sfm/build/kitti_vo_testbench",
      "args": ["/data/tests_data/sfm/", "/atom/programming/robotics/sfm/out", "-s", "03", "-i", "0", "-e", "30", "-v"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    },
    {
      "name": "(gdb) Launch sfm_example",
      "type": "cppdbg",
